{
  "expo": {
    "name": "AndroidMetro",
    "slug": "metro-bilbao",
    "version": "2.0.0",
    "orientation": "default",
    "icon": "./assets/androidmetro-icon-minimal-512.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A2E"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#011228",
        "foregroundImage": "./assets/androidmetro-icon-foreground.png",
        "monochromeImage": "./assets/androidmetro-icon-monochrome.png"
      },
      "package": "com.metrobilbao.widget",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "icon": "./assets/androidmetro-icon-minimal-512.png"
    },
    "plugins": [
      "./plugins/withReleaseSafety",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MetroBilbaoWidget",
              "label": "AndroidMetro",
              "minWidth": "240dp",
              "minHeight": "280dp",
              "description": "Consulta todos los trenes de tus trayectos favoritos",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "targetCellWidth": 4,
              "targetCellHeight": 4
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "990b536c-ce8d-4a17-82f6-412aeee0e317"
      }
    }
  }
}
