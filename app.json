{
  "expo": {
    "name": "Metro Bilbao",
    "slug": "metro-bilbao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/androidmetro-icon-minimal-512.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A2E"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#011228",
        "foregroundImage": "./assets/androidmetro-icon-foreground.png",
        "monochromeImage": "./assets/androidmetro-icon-monochrome.png"
      },
      "package": "com.metrobilbao.widget",
      "icon": "./assets/androidmetro-icon-minimal-512.png"
    },
    "plugins": [
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "MetroBilbaoWidget",
              "label": "Metro Bilbao",
              "minWidth": "320dp",
              "minHeight": "320dp",
              "description": "Próximos trenes del Metro de Bilbao - 4 paneles configurables",
              "updatePeriodMillis": 1800000,
              "resizeMode": "horizontal|vertical",
              "widgetFeatures": "reconfigurable",
              "targetCellWidth": 4,
              "targetCellHeight": 4
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "990b536c-ce8d-4a17-82f6-412aeee0e317"
      }
    }
  }
}
